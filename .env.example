APP_PORT=2026
SQLITE_PATH=./data/focus-os.sqlite
SESSION_SECRET=generate-a-unique-secret-of-at-least-32-characters
WORKSPACE_ENCRYPTION_KEY=generate-a-second-unique-secret-of-at-least-32-characters
SESSION_TTL_DAYS=90
# Ustaw true za reverse proxy z HTTPS. Dla lokalnej sieci HTTP pozostaw false.
COOKIE_SECURE=false
# Optional: comma-separated public HTTPS origins when a reverse proxy is used.
# APP_ORIGIN=https://focus.example.com
